@model PrintingPlatform.Models.Checkout.CheckoutViewModel

@{
    Layout = "_SpikeLanding";
    ViewData["Title"] = "Checkout";
}

<style>
    .qty-control {
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        overflow: hidden;
        min-width: 132px;
        height: 40px;
        background: #fff;
    }

    .qty-btn {
        width: 40px;
        height: 40px;
        border: 0;
        background: #fff;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .qty-btn:hover {
        background: #f8f9fa;
        color: #0d6efd;
    }

    .qty-value {
        width: 52px;
        height: 40px;
        border-left: 1px solid var(--bs-border-color);
        border-right: 1px solid var(--bs-border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: #495057;
        background: #fff;
    }

    .option-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        border: 1px solid var(--bs-border-color);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #fff;
    }

    .option-card:hover {
        border-color: #0d6efd;
        background: #f8fbff;
    }

    .option-card input[type="radio"] {
        margin-top: 4px;
    }
</style>

<section class="py-5">
    <div class="container-xxl">

        <div class="mb-4">
            <h4 class="fs-6 mb-1">Checkout</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Checkout</li>
                </ol>
            </nav>
        </div>

        @if (TempData["CheckoutSuccess"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.HasItems)
        {
            <div class="card border shadow-none">
                <div class="card-body p-4 text-center">
                    <h5 class="mb-2">Your cart is empty</h5>
                    <p class="text-muted mb-3">Add products before proceeding to checkout.</p>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">
                        Return to Catalog
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-xl-8">

                    <div class="card border shadow-none mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-semibold mb-4">Items in your order</h5>

                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th class="ps-0">Product</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-end pe-0">Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.CartItems)
                                        {
                                            var image = string.IsNullOrWhiteSpace(item.ImageUrl)
                                                ? Url.Content("~/assets/images/products/s1.jpg")
                                                : item.ImageUrl;

                                            var lineTotal = item.Price * item.Quantity;

                                            <tr>
                                                <td class="ps-0">
                                                    <div class="d-flex gap-3 align-items-center">
                                                        <img src="@image"
                                                             width="72"
                                                             height="72"
                                                             class="rounded"
                                                             style="object-fit: cover;" />
                                                        <h6 class="mb-0 fw-semibold">@item.ProductName</h6>
                                                    </div>
                                                </td>

                                                <td class="text-center">
                                                    <div class="d-inline-flex justify-content-center">
                                                        <div class="qty-control d-flex align-items-center">
                                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="m-0">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Checkout")" />
                                                                <button class="qty-btn" type="submit" aria-label="Decrease quantity">
                                                                    <i class="ti ti-minus"></i>
                                                                </button>
                                                            </form>

                                                            <div class="qty-value">@item.Quantity</div>

                                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="m-0">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Checkout")" />
                                                                <button class="qty-btn" type="submit" aria-label="Increase quantity">
                                                                    <i class="ti ti-plus"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="text-end pe-0">
                                                    <h6 class="mb-0 fw-semibold">$@lineTotal.ToString("0.00")</h6>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="card border shadow-none">
                        <div class="card-body p-4">
                            <form asp-controller="Checkout" asp-action="Index" method="post">
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" }, "div")

                                <h5 class="mb-4">Billing &amp; Address</h5>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="FullName" class="form-label"></label>
                                        <input asp-for="FullName" class="form-control" />
                                        <span asp-validation-for="FullName" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label"></label>
                                        <input asp-for="Email" class="form-control" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Address" class="form-label"></label>
                                        <input asp-for="Address" class="form-control" />
                                        <span asp-validation-for="Address" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="City" class="form-label"></label>
                                        <input asp-for="City" class="form-control" />
                                        <span asp-validation-for="City" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="PostalCode" class="form-label"></label>
                                        <input asp-for="PostalCode" class="form-control" />
                                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 mt-4">
                                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">
                                        Back to Catalog
                                    </a>

                                    <button type="submit" class="btn btn-success">
                                        Place Order
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="card border shadow-none mb-4">
                        <div class="card-body p-4">
                            <h5 class="mb-4">Order Summary</h5>

                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Sub Total</span>
                                <span class="fw-semibold">$@Model.Subtotal.ToString("0.00")</span>
                            </div>

                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Shipping</span>
                                <span class="fw-semibold">
                                    @(Model.ShippingCost <= 0 ? "Free" : $"${Model.ShippingCost.ToString("0.00")}")
                                </span>
                            </div>

                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Tax</span>
                                <span class="fw-semibold">$@Model.Tax.ToString("0.00")</span>
                            </div>

                            <hr class="my-3" />

                            <div class="d-flex justify-content-between fw-bold">
                                <span>Total</span>
                                <span>$@Model.Total.ToString("0.00")</span>
                            </div>
                        </div>
                    </div>

                    <div class="card border shadow-none mb-4">
                        <div class="card-body p-4">
                            <h5 class="mb-4">Delivery</h5>

                            <label class="option-card mb-3">
                                <input type="radio" name="DeliveryMethod" value="Standard" checked />
                                <div>
                                    <div class="fw-semibold">Standard delivery</div>
                                    <div class="text-muted small">Ships to your address</div>
                                </div>
                            </label>

                            <label class="option-card">
                                <input type="radio" name="DeliveryMethod" value="Pickup" />
                                <div>
                                    <div class="fw-semibold">Local pickup</div>
                                    <div class="text-muted small">Pick up your order locally</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="card border shadow-none">
                        <div class="card-body p-4">
                            <h5 class="mb-4">Payment</h5>

                            <label class="option-card mb-3">
                                <input type="radio" name="PaymentMethod" value="Stripe" checked />
                                <div>
                                    <div class="fw-semibold">Stripe test checkout</div>
                                    <div class="text-muted small">Secure test payment via Stripe</div>
                                </div>
                            </label>

                            <label class="option-card">
                                <input type="radio" name="PaymentMethod" value="Confirmation" />
                                <div>
                                    <div class="fw-semibold">Pay after confirmation</div>
                                    <div class="text-muted small">We will review your order details before production</div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}