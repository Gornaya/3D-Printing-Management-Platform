@model PrintingPlatform.Models.Checkout.CheckoutViewModel

@{
    Layout = "_SpikeLanding";
    ViewData["Title"] = "Checkout";
}

<section class="py-5">
    <div class="container-xxl">
        <div class="mb-3 overflow-hidden position-relative">
            <div class="px-3">
                <h4 class="fs-6 mb-0">Checkout</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="breadcrumb-item" aria-current="page">Checkout</li>
                    </ol>
                </nav>
            </div>
        </div>

        @if (TempData["CheckoutSuccess"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["CheckoutError"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.HasItems)
        {
            <div class="card border shadow-none">
                <div class="card-body p-4 text-center">
                    <h5>Your cart is empty</h5>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-3">Return to Catalog</a>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-none border">
                <div class="card-body p-4">
                    <div class="wizard-content">
                        <form asp-controller="Checkout" asp-action="Index" method="post">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" }, "div")

                            <!-- Step 1 -->
                            <h6>Cart</h6>
                            <section>
                                <div class="table-responsive">
                                    <table class="table align-middle text-nowrap mb-0">
                                        <thead class="fs-2">
                                            <tr>
                                                <th>Product</th>
                                                <th>Quantity</th>
                                                <th class="text-end">Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.CartItems)
                                            {
                                                <tr>
                                                    <td class="border-bottom-0">
                                                        <div class="d-flex align-items-center gap-3 overflow-hidden">
                                                            <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? Url.Content("~/assets/images/products/s1.jpg") : item.ImageUrl)"
                                                                 alt="@item.ProductName"
                                                                 class="img-fluid rounded"
                                                                 width="80" />
                                                            <div>
                                                                <h6 class="fw-semibold fs-4 mb-0">@item.ProductName</h6>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="border-bottom-0">
                                                        <div class="fs-4 fw-semibold">@item.Quantity</div>
                                                    </td>
                                                    <td class="text-end border-bottom-0">
                                                        <h6 class="fs-4 fw-semibold mb-0">$@((item.Price * item.Quantity).ToString("0.00"))</h6>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="order-summary border rounded p-4 my-4">
                                    <div class="p-3">
                                        <h5 class="fs-5 fw-semibold mb-4">Order Summary</h5>
                                        <div class="d-flex justify-content-between mb-4">
                                            <p class="mb-0 fs-4">Sub Total</p>
                                            <h6 class="mb-0 fs-4 fw-semibold">$@Model.Subtotal.ToString("0.00")</h6>
                                        </div>
                                        <div class="d-flex justify-content-between mb-4">
                                            <p class="mb-0 fs-4">Shipping</p>
                                            <h6 class="mb-0 fs-4 fw-semibold">$@Model.ShippingCost.ToString("0.00")</h6>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-0 fs-4 fw-semibold">Total</h6>
                                            <h6 class="mb-0 fs-5 fw-semibold">$@Model.Total.ToString("0.00")</h6>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- Step 2 -->
                            <h6>Billing & address</h6>
                            <section>
                                <div class="billing-address-content">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="FullName" class="form-label"></label>
                                            <input asp-for="FullName" class="form-control" />
                                            <span asp-validation-for="FullName" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Email" class="form-label"></label>
                                            <input asp-for="Email" class="form-control" />
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="Address" class="form-label"></label>
                                            <input asp-for="Address" class="form-control" />
                                            <span asp-validation-for="Address" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="City" class="form-label"></label>
                                            <input asp-for="City" class="form-control" />
                                            <span asp-validation-for="City" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="PostalCode" class="form-label"></label>
                                            <input asp-for="PostalCode" class="form-control" />
                                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="order-summary border rounded p-4 my-4">
                                        <div class="p-3">
                                            <h5 class="fs-5 fw-semibold mb-4">Order Summary</h5>
                                            <div class="d-flex justify-content-between mb-4">
                                                <p class="mb-0 fs-4">Sub Total</p>
                                                <h6 class="mb-0 fs-4 fw-semibold">$@Model.Subtotal.ToString("0.00")</h6>
                                            </div>
                                            <div class="d-flex justify-content-between mb-4">
                                                <p class="mb-0 fs-4">Shipping</p>
                                                <h6 class="mb-0 fs-4 fw-semibold">$@Model.ShippingCost.ToString("0.00")</h6>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <h6 class="mb-0 fs-4 fw-semibold">Total</h6>
                                                <h6 class="mb-0 fs-5 fw-semibold">$@Model.Total.ToString("0.00")</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- Step 3 -->
                            <h6>Payment</h6>
                            <section class="payment-method">
                                <div class="payment-method-list">
                                    <div class="delivery-option btn-group-active card shadow-none border">
                                        <div class="card-body p-4">
                                            <h6 class="mb-3 fw-semibold fs-4">Delivery Option</h6>
                                            <div class="btn-group flex-row gap-3 w-100" role="group" aria-label="Delivery options">
                                                <div class="position-relative form-check btn-custom-fill flex-fill ps-0">
                                                    <input type="radio" class="form-check-input ms-4 round-16" checked="checked" disabled />
                                                    <label class="btn btn-outline-primary mb-0 p-3 rounded ps-5 w-100">
                                                        <div class="text-start ps-2">
                                                            <h6 class="fs-4 fw-semibold mb-0">Standard delivery</h6>
                                                            <p class="mb-0 text-muted">Shipping cost: $@Model.ShippingCost.ToString("0.00")</p>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="payment-option btn-group-active card shadow-none border">
                                        <div class="card-body p-4">
                                            <h6 class="mb-3 fw-semibold fs-4">Payment Option</h6>
                                            <div class="row">
                                                <div class="col-lg-8">
                                                    <div class="btn-group flex-column w-100" role="group" aria-label="Payment options">
                                                        <div class="position-relative mb-3 w-100 form-check btn-custom-fill ps-0">
                                                            <input type="radio" class="form-check-input ms-4 round-16" checked="checked" disabled />
                                                            <label class="btn btn-outline-primary mb-0 p-3 rounded ps-5 w-100">
                                                                <div class="d-flex align-items-center">
                                                                    <div class="text-start ps-2">
                                                                        <h6 class="fs-4 fw-semibold mb-0">Manual checkout</h6>
                                                                        <p class="mb-0 text-muted">
                                                                            This is a demo checkout flow. Order details will be submitted for processing.
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-lg-4 d-flex align-items-center justify-content-center">
                                                    <div class="text-center">
                                                        <h6 class="fs-4 fw-semibold mb-2">Total</h6>
                                                        <div class="fs-7 fw-bold">$@Model.Total.ToString("0.00")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="order-summary border rounded p-4 my-4">
                                        <div class="p-3">
                                            <h5 class="fs-5 fw-semibold mb-4">Order Summary</h5>
                                            <div class="d-flex justify-content-between mb-4">
                                                <p class="mb-0 fs-4">Sub Total</p>
                                                <h6 class="mb-0 fs-4 fw-semibold">$@Model.Subtotal.ToString("0.00")</h6>
                                            </div>
                                            <div class="d-flex justify-content-between mb-4">
                                                <p class="mb-0 fs-4">Shipping</p>
                                                <h6 class="mb-0 fs-4 fw-semibold">$@Model.ShippingCost.ToString("0.00")</h6>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <h6 class="mb-0 fs-4 fw-semibold">Total</h6>
                                                <h6 class="mb-0 fs-5 fw-semibold">$@Model.Total.ToString("0.00")</h6>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-sm-flex align-items-center justify-content-between my-4">
                                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary d-block mb-2 mb-sm-0">
                                            Back to Cart
                                        </a>
                                        <button type="submit" class="btn btn-success d-block">
                                            Place Order
                                        </button>
                                    </div>
                                </div>
                            </section>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}